# Profils d'environnement de l'audit UX. Copier en `.env` (ignoré par git).
#
# Un profil se nomme par son suffixe : AUDIT_STAGING_URL crée `--env=staging`.
# `local` a une valeur par défaut (http://localhost:3000) et n'a rien à déclarer
# tant que la console tourne avec AUTH_OPTIONAL=1.

AUDIT_LOCAL_URL=http://localhost:3000

# Identifiants, si l'environnement demande une session. Jamais dans le code.
# AUDIT_USERNAME=
# AUDIT_PASSWORD=

# Un second environnement, avec ses propres identifiants :
# AUDIT_STAGING_URL=https://ops-staging.exemple.fr
# AUDIT_STAGING_USERNAME=
# AUDIT_STAGING_PASSWORD=

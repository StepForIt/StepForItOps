# PostgreSQL
DATABASE_URL=postgresql://nwm:nwm@localhost:5432/nwm?schema=public
POSTGRES_USER=nwm
POSTGRES_PASSWORD=nwm
POSTGRES_DB=nwm

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Ports publiés sur la machine hôte (dev, docker-compose.override.yml) — à
# changer en cas de conflit
API_HOST_PORT=3001
WEB_HOST_PORT=3000
# Le 5432 est souvent pris par la base d'un autre projet. Ne concerne que
# l'accès depuis la machine : l'api joint postgres par le réseau interne.
POSTGRES_HOST_PORT=5432

# Web — laisser vide : le front passe par son proxy /backend (réseau Docker).
# Ne définir que pour pointer une API distante directement depuis le navigateur.
# Incompatible avec API_ACCESS_TOKEN (le jeton n'est injecté que par le proxy).
NEXT_PUBLIC_API_URL=

# --- Authentification (front) ---
# Tant qu'aucune méthode n'est configurée, la plateforme reste ouverte (dev local).
# Dès que GOOGLE_CLIENT_ID/SECRET ou APP_PASSWORD est posé, tout est protégé.

# URL publique du front. Indispensable derrière un reverse proxy :
# sert de base au redirect_uri OAuth et aux redirections post-login.
APP_BASE_URL=http://localhost:3000

# Connexion Google (méthode principale). Client OAuth « Web application » dans
# Google Cloud, avec l'URI de redirection : <APP_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domaines Workspace autorisés (CSV) — OBLIGATOIRE avec Google : sans lui, la
# connexion Google refuse tout le monde. Un compte Gmail perso est toujours refusé.
GOOGLE_ALLOWED_DOMAIN=

# Connexion identifiant / mot de passe (repli, ou dépannage sans Google)
APP_USERNAME=admin
APP_PASSWORD=

# Secret de signature du cookie de session — recommandé dès qu'une auth est
# active : `openssl rand -hex 32`. À défaut : GOOGLE_CLIENT_SECRET, puis
# APP_PASSWORD (déconseillé : un mot de passe court rend les sessions
# forgeables). Le changer déconnecte tout le monde.
SESSION_SECRET=

# Jeton partagé front → API, injecté par le proxy Next (jamais exposé au
# navigateur). Requis par docker-compose.yml : sans lui, une API qui a son
# propre domaine public est joignable anonymement. Le heartbeat
# /monitoring/beat/:token reste public. En prod : `openssl rand -hex 32`.
# En local, docker-compose.override.yml le vide : l'API reste ouverte.
API_ACCESS_TOKEN=dev

# Export de configuration (module config-transfer). Fermé par défaut : le bundle
# emporte en clair les clés API n8n, tokens GitHub / Drive, mot de passe Kuma,
# clé Anthropic et jetons de heartbeat — un seul GET suffit à tout sortir.
# Posé uniquement par docker-compose.override.yml (dev local), jamais par
# docker-compose.yml (prod) : sur un serveur la route répond 403. L'import, lui, reste toujours disponible.
CONFIG_EXPORT_ENABLED=

# Logs de la plateforme (module app-logs) : nombre de lignes gardées en mémoire
# du process et servies à l'écran /app-logs. Défaut 2000. Le tampon double la
# sortie du conteneur, il ne la remplace pas — un redémarrage le vide.
APP_LOG_BUFFER=

# IA (module verifier / organizer / doc-schema / optimizer). Deux fournisseurs
# possibles ; celui qui sert les appels se choisit dans Modules -> Réglages IA,
# et les réglages en DB priment sur ces variables.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# Documentation des systèmes tiers (assistant IA, outils search_docs / read_docs).
# FACULTATIF : sans clé, Context7 répond quand même, plafonné par IP. La clé ne
# fait que relever ce plafond — une plateforme sans compte garde l'outil.
CONTEXT7_API_KEY=

# Export GitHub (module versioning) — configurable aussi par ExportTarget en DB
GITHUB_TOKEN=

# Export Google Drive (module versioning)
GDRIVE_ACCESS_TOKEN=

# Uptime Kuma — connecteur de provisioning (création auto des sondes push)
# URL de l'UI Kuma + identifiants admin (API Socket.io, pas de REST officielle)
KUMA_URL=
KUMA_USERNAME=
KUMA_PASSWORD=

# URL publique de l'API (utilisée dans les snippets heartbeat collés dans n8n)
API_PUBLIC_URL=http://localhost:3001

# --- Remontée des erreurs (Sentry / GlitchTip) ---
# Optionnel : sans DSN, rien n'est initialisé (aucun appel sortant). Le protocole
# étant le même, un DSN GlitchTip auto-hébergé se pose ici tel quel.
# Mise en place et limites : docs/sentry.md

# DSN de l'API (serveur). Ne sort jamais du conteneur.
SENTRY_DSN=

# DSN du front. PUBLIC par construction — il part dans le bundle du navigateur,
# et n'autorise que l'envoi d'événements. Inliné au BUILD (build arg) : le poser
# au runtime ne change rien tant que l'image n'est pas reconstruite.
NEXT_PUBLIC_SENTRY_DSN=

# Nom de l'environnement affiché dans les événements (prod, preprod, dev…).
SENTRY_ENVIRONMENT=
# Version déployée, pour rattacher une erreur à un déploiement (ex: sha du commit).
SENTRY_RELEASE=
# Traces de performance, entre 0 et 1. 0 par défaut : GlitchTip ne les stocke pas.
SENTRY_TRACES_SAMPLE_RATE=

# Téléversement des sourcemaps du front au build (Sentry SaaS surtout). Sans
# jeton, le build n'en envoie aucune et n'échoue pas pour autant.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

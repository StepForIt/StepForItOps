{
  "name": "Integration Webhooks, HTTP",
  "flow": [
    {
      "id": 2,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 1,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {
          "parameters": {
            "hook": {
              "label": "Mon webhook",
              "data": {
                "editable": "true"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-webhook",
            "label": "Webhook",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "label": "Maximum number of results"
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "http:DownloadFile",
      "version": 4,
      "parameters": {
        "authenticationType": "noAuth"
      },
      "mapper": {
        "url": "https://example.test/fichier.pdf",
        "stopOnHttpError": true,
        "shareCookies": false
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {
          "parameters": {
            "authenticationType": {
              "label": "No authenticationUse when no credentials are required for the request."
            }
          },
          "expect": {
            "stopOnHttpError": {
              "mode": "chose"
            },
            "shareCookies": {
              "mode": "chose"
            },
            "headers": {
              "mode": "chose"
            },
            "queryParameters": {
              "mode": "chose"
            }
          }
        },
        "parameters": [
          {
            "name": "authenticationType",
            "type": "select",
            "label": "Authentication type",
            "required": true,
            "validate": {
              "enum": ["noAuth", "apiKey", "basicAuth", "oAuth"]
            }
          }
        ],
        "expect": [
          {
            "name": "url",
            "type": "url",
            "label": "URL",
            "required": true
          },
          {
            "name": "stopOnHttpError",
            "type": "boolean",
            "label": "Return error if HTTP request fails",
            "required": true
          },
          {
            "name": "shareCookies",
            "type": "boolean",
            "label": "Share cookies with other HTTP modules",
            "required": true
          },
          {
            "name": "headers",
            "type": "array",
            "label": "Headers",
            "spec": {
              "name": "value",
              "label": "Header",
              "type": "collection",
              "spec": [
                {
                  "name": "name",
                  "label": "Name",
                  "type": "text",
                  "required": true,
                  "validate": {
                    "pattern": "^[-!#$%&'*+.^_`|~0-9A-Za-z]+$"
                  }
                },
                {
                  "name": "value",
                  "label": "Value",
                  "type": "text"
                }
              ]
            }
          },
          {
            "name": "queryParameters",
            "type": "array",
            "label": "Query parameters",
            "spec": {
              "name": "value",
              "label": "Parameter",
              "type": "collection",
              "spec": [
                {
                  "name": "name",
                  "label": "Name",
                  "type": "text",
                  "required": true
                },
                {
                  "name": "value",
                  "label": "Value",
                  "type": "text"
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "eu1.make.com",
    "notes": []
  }
}
